<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TibiaLegacy</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TibiaLegacy.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-gray border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand text-black ms-3 fs-4 fw-bold" style="padding-left: 20px; padding-top: 20px; font-family: Helvetica, arial, sans-serif" asp-area="" asp-controller="Legacy" asp-action="Index">TibiaLegacy</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-black ms-3 fs-5 fw-bold" style="padding-top: 30px; font-family: Helvetica, arial, sans-serif" asp-area="" asp-controller="WorldPlayer" asp-action="Index">World/Player</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-black ms-2 fs-5 fw-bold" style="padding-top: 30px; font-family: Helvetica, arial, sans-serif" asp-area="" asp-controller="Criaturas" asp-action="Index">Creatures</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container text-light bol">
            &copy; 2024 - TibiaLegacy - <a asp-area="" asp-controller="Legacy" asp-action="Privacy" class="text-warning">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
